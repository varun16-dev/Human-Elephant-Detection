# ==============================================================================
# SMS Gateway for Android (SMSGate - Local Server Mode)
# Documentation: https://docs.sms-gate.app
# ==============================================================================

# Local Android Phone SMS Gateway Base URL (e.g. http://192.168.1.50:8080)
# Must be a private, loopback, CGNAT IP, or .local / .lan domain
SMSGATE_BASE_URL=http://192.168.1.150:8080

# Basic Authentication Credentials configured inside the SMSGate Android app
SMSGATE_USERNAME=smsgate
SMSGATE_PASSWORD=change_this_secure_password

# API Path for message dispatch (default is /messages, use /message if configured)
SMSGATE_MESSAGES_PATH=/messages

# Network timeout in seconds (default: 8.0)
SMSGATE_TIMEOUT=8.0

# Retry configuration for transient errors (connection, timeout, 5xx)
SMSGATE_MAX_RETRIES=3
SMSGATE_BACKOFF=2.0

# Outbound SMS message TTL and priority
SMS_TTL_SECONDS=900
SMS_PRIORITY=100

# Security Override (ONLY set to true if running through an explicit secure reverse proxy/tunnel)
SMSGATE_ALLOW_PUBLIC_HOST=false

# Default SMS Provider (smsgate is default; fallback to textbee only if explicitly specified)
SMS_PROVIDER=smsgate
